# ===================================================
# AI PDF Chatbot - Environment Configuration Template
# ===================================================

# LLM Provider: Groq API Key (https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Supabase Vector Database Credentials (https://supabase.com)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# LangGraph Server API URLs
LANGGRAPH_API_URL=http://127.0.0.1:2024
NEXT_PUBLIC_LANGGRAPH_API_URL=http://127.0.0.1:2024

# Assistant Graph Identifiers
LANGGRAPH_RETRIEVAL_ASSISTANT_ID=retrieval_graph
LANGGRAPH_INGESTION_ASSISTANT_ID=ingestion_graph

# Optional: LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-pdf-chatbot
