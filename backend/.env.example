# Required: Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Optional: OpenAI API Key (only if you want to use OpenAI models/embeddings instead of Groq)
OPENAI_API_KEY=

# Required for Supabase vector store (or leave empty for in-memory store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: LangSmith for tracing (recommended for development)
LANGCHAIN_TRACING_V2=false
# Optional: LangSmith API key to access deployed graph
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent-pdf-chatbot