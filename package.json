{
  "name": "ai-pdf-chatbot-langchain",
  "description": "AI PDF chatbot template based on the book Learning LangChain (O'Reilly)",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": "Mayo Oshin",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:backend": "yarn --cwd backend langgraph:dev",
    "dev:frontend": "yarn --cwd frontend dev",
    "build": "yarn --cwd backend build && yarn --cwd frontend build",
    "start": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"yarn --cwd backend start\" \"yarn --cwd frontend start\"",
    "turbo:command": "yarn turbo",
    "postinstall": "node scripts/patch-langgraph-cli.js",
    "lint": "yarn run turbo:command lint",
    "lint:fix": "yarn run turbo:command lint:fix",
    "format": "yarn run turbo:command format",
    "format:check": "yarn run turbo:command format:check"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "latest"
  }
}
